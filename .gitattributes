# Repository text is stored with LF in the index: pin the working copy to LF as
# well, so an editor or script that writes LF cannot leave a line-ending-only
# modification on a clone that checks text files out with CRLF
# (core.autocrlf=true on Windows). Binary content is detected automatically.
* text=auto eol=lf

# Golden artifacts are compared byte for byte under RO-111, and a font program
# is embedded as-is: never let a checkout convert their line endings or the
# published SHA-256 digest would no longer describe the working tree.
tests/regression/pdf/*.pdf -text -eol
tests/regression/postscript/*.ps -text -eol
tests/conformance/fixtures/renderspec/fonts/*.ttf -text -eol
