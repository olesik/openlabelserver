{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openlabelserver.org/schemas/conformancespec-report-v1.0.json",
  "title": "ConformanceSpec Report",
  "description": "Conformance report format defined by ConformanceSpec v1.0 Section 16. The schema covers the document structure and per-entry requirements; CR-1 to CR-7 also cover relationships between members that a schema cannot express.",
  "type": "object",
  "required": [
    "conformance",
    "profiles",
    "implementation",
    "specifications",
    "suite",
    "environment",
    "results",
    "summary",
    "generated_at"
  ],
  "properties": {
    "conformance": {
      "type": "string",
      "description": "The ConformanceSpec version the report was produced against (CR-1).",
      "enum": ["1.0"]
    },
    "profiles": {
      "type": "array",
      "description": "Conformance profiles claimed by the implementation.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "CP-RS",
          "CP-ST",
          "CP-CAL",
          "CP-CE",
          "CP-RND",
          "CP-API",
          "CP-CLI",
          "CP-PIPE",
          "CP-PERF"
        ]
      }
    },
    "implementation": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the implementation under test."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the implementation under test."
        }
      }
    },
    "specifications": {
      "type": "object",
      "description": "Versions of the specifications the report is bound to (Section 17).",
      "required": ["renderspec", "stockspec", "calibrationspec", "api"],
      "properties": {
        "renderspec": {
          "type": "string",
          "minLength": 1
        },
        "stockspec": {
          "type": "string",
          "minLength": 1
        },
        "calibrationspec": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "suite": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the conformance suite that produced the report."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the conformance suite that produced the report."
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["os", "arch", "runtime"],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "results": {
      "type": "array",
      "description": "One entry per requirement of every claimed profile (CR-2).",
      "items": {
        "type": "object",
        "required": ["requirement", "status"],
        "properties": {
          "requirement": {
            "type": "string",
            "description": "Requirement ID from the specification.",
            "pattern": "^[A-Z]{2,4}-[0-9]{1,3}$"
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "not-applicable", "not-tested"]
          },
          "details": {
            "type": "string",
            "minLength": 1,
            "description": "Observed and expected values; required when the status is fail (CR-7)."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why the requirement was not applicable or not tested (CR-4, CR-5)."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": ["not-applicable", "not-tested"]
                }
              },
              "required": ["status"]
            },
            "then": {
              "required": ["reason"]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "fail"
                }
              },
              "required": ["status"]
            },
            "then": {
              "required": ["details"]
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "description": "Counts that must agree with results (CR-6).",
      "required": ["total", "passed", "failed", "not_applicable", "not_tested"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "not_tested": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "generated_at": {
      "type": "string",
      "description": "UTC timestamp in ISO 8601 form (CR-6), e.g. 2026-11-14T12:00:00Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
