  "computations": [
    {
      "requirement": "CS-112",
      "description": "normative calibration worked example and 90-degree convention",
      "check": "calibration_worked_example"
    },
    {
      "requirement": "CS-118",
      "description": "identity profile leaves sample points unchanged",
      "check": "calibration_identity"
    },
    {
      "requirement": "CS-120",
      "description": "YAML and JSON forms parse to the same model",
      "check": "calibration_yaml_json_equivalence"
    },
    {
      "requirement": "CN-106",
      "description": "rejection diagnostics identify the offending path",
      "check": "diagnostic_location"
    },
    {
      "requirement": "CR-1",
      "description": "emitted report satisfies the ConformanceSpec report format and names the suite commit and zlib build",
      "check": "report_is_well_formed"
    },
    {
      "requirement": "AP-101",
      "description": "resource URIs are under /v1: GET /v1/templates succeeds with the list envelope, and an unversioned GET /templates is not a success response",
      "check": "resource_uris_are_versioned"
    },
    {
      "requirement": "AP-102",
      "description": "GET /v1/info reports api_version and every response carries X-API-Version",
      "check": "api_version_is_reported"
    },
    {
      "requirement": "AP-103",
      "description": "GET /v1/health answers 200 with status ok",
      "check": "health_reports_ok"
    },
    {
      "requirement": "AP-104",
      "description": "a 404 and a 422 are problem+json carrying type, title and status",
      "check": "error_responses_are_problem_documents"
    },
    {
      "requirement": "AP-105",
      "description": "each error type URI is the API Section 5.2 entry for its status (400, 404, 409, 422)",
      "check": "error_types_name_their_condition"
    },
    {
      "requirement": "AP-106",
      "description": "a 422 validation response lists field and message for each failure",
      "check": "validation_errors_carry_field_and_message"
    },
    {
      "requirement": "AR-101",
      "description": "templates expose list, create, retrieve, replace, metadata patch, delete and stateless validate",
      "check": "template_resource_supports_every_operation"
    },
    {
      "requirement": "AR-102",
      "description": "a template id equals document.id, and a replace whose document names another id answers 409 Conflict",
      "check": "replace_rejects_a_document_naming_another_id"
    },
    {
      "requirement": "AR-103",
      "description": "creating a template whose id already exists answers 409 Conflict",
      "check": "create_rejects_a_duplicate_id"
    },
    {
      "requirement": "AR-104",
      "description": "stocks and calibration profiles take their id from document.metadata.id, answer 409 Conflict for a duplicate create and for a replace whose path names another id, and leave the stored documents unmodified",
      "check": "stocks_and_calibrations_normalize_their_identity"
    },
    {
      "requirement": "AR-105",
      "description": "assets are uploaded as multipart/form-data with a required file field, answer 201 with an opaque ast_ id, and download byte for byte under a documented content type",
      "check": "assets_are_uploaded_and_served_byte_identically"
    },
    {
      "requirement": "AJ-107",
      "description": "a stored template names an uploaded asset by the API asset URI the upload published, whatever host the client sent, keeps an external HTTPS URL and a base64 data URI as sent, and that URI serves the uploaded bytes",
      "check": "asset_references_in_stored_templates_use_the_published_forms"
    },
    {
      "requirement": "AR-106",
      "description": "an invalid RenderSpec is rejected with 422 before persistence and is never stored",
      "check": "invalid_documents_are_not_stored"
    },
    {
      "requirement": "AQ-101",
      "description": "stateless validation answers 200 for the document's own id and 409 for another, creates nothing, and neither reads nor overwrites a stored template",
      "check": "stateless_validation_persists_nothing"
    },
    {
      "requirement": "AP-110",
      "description": "127 stored templates page as the envelope's arithmetic says: page=3&page_size=50 is 27 items on page 3 of 3 with no next page, the defaults are 20 items over 7 pages, and walking the pages repeats no id",
      "check": "pagination_arithmetic_over_a_seeded_catalog"
    },
    {
      "requirement": "AP-111",
      "description": "a paginated response carries RFC 8288 Link relations for next and first, and each target answers the page it names at the same page size",
      "check": "pagination_links_name_the_first_and_next_pages"
    },
    {
      "requirement": "CN-102",
      "description": "coordinate convention: top-left origin, X right, Y down, millimetres, clockwise rotation",
      "check": "renderspec_coordinate_convention"
    },
    {
      "requirement": "CN-105",
      "description": "strict parsing is the default and forward compatibility drops unknown properties only",
      "check": "renderspec_forward_compatibility"
    },
    {
      "requirement": "SS-101",
      "description": "YAML and JSON StockSpec forms parse to the same object model",
      "check": "stockspec_yaml_json_equivalence"
    },
    {
      "requirement": "CS-106",
      "description": "rotation angles outside [0, 360) normalize for evaluation",
      "check": "calibration_angle_normalization"
    },
    {
      "requirement": "CS-113",
      "description": "the engine calibrates post-layout coordinates, not pre-layout ones",
      "check": "calibration_post_layout_application"
    },
    {
      "requirement": "CS-114",
      "description": "profile selection follows the stock, page-format, printer, identity precedence",
      "check": "calibration_selection_precedence"
    },
    {
      "requirement": "CS-114",
      "description": "a target with only informational fields still matches the printer-only level",
      "check": "calibration_informational_target_fallback"
    },
    {
      "requirement": "CS-115",
      "description": "equally ranked profiles reject with AJ-108 unless timestamps order them",
      "check": "calibration_ambiguous_selection"
    },
    {
      "requirement": "CS-116",
      "description": "a stock-scoped profile does not match another stock sharing its format",
      "check": "calibration_stock_scoped_selection"
    },
    {
      "requirement": "CS-109",
      "description": "a disabled profile leaves coordinates unchanged and is never selected",
      "check": "calibration_disabled_profile_is_identity"
    },
    {
      "requirement": "CS-117",
      "description": "values outside the recommended ranges warn without failing",
      "check": "calibration_recommended_range_warnings"
    },
    {
      "requirement": "CS-119",
      "description": "identical input produces identical coordinates across implementations",
      "check": "calibration_independent_engine_agreement"
    },
    {
      "requirement": "CS-122",
      "description": "target.media_type never influences profile selection",
      "check": "calibration_media_type_is_ignored"
    },
    {
      "requirement": "SS-104",
      "description": "frame origins follow margins + index x pitch for all 30 frames of avery_5160",
      "check": "stockspec_frame_origins"
    },
    {
      "requirement": "SS-113",
      "description": "4 records over a 2 x 2 grid fill column-first",
      "check": "stockspec_row_major_fill"
    },
    {
      "requirement": "SS-115",
      "description": "declared page dimensions drive geometry when page.format says a4",
      "check": "stockspec_declared_dimensions"
    },
    {
      "requirement": "SS-118",
      "description": "layout is identical with different or missing timestamps",
      "check": "stockspec_layout_ignores_timestamps"
    },
    {
      "requirement": "RS-118",
      "description": "a rect past a 50 x 30 mm label is accepted and yields one warning",
      "check": "renderspec_boundary_overflow"
    },
    {
      "requirement": "SS-112",
      "description": "four full-bleed fixtures clip to their declared label shape",
      "check": "stockspec_shape_clipping"
    },
    {
      "requirement": "RT-104",
      "description": "each stock-grid label clips to its frame without bleeding",
      "check": "renderspec_frame_clipping"
    },
    {
      "requirement": "RT-101",
      "description": "without stock the page renders once at the page origin",
      "check": "renderspec_page_absolute_once"
    },
